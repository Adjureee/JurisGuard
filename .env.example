DATABASE_URL=postgresql://postgres:change-me@localhost:5432/jurisguard
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Required only for initial admin registration; set a random 32+ character server-only key, then remove it.
# ADMIN_BOOTSTRAP_KEY=
MISTRAL_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api
# Optional locally hosted map tile URL, e.g. /tiles/{z}/{x}/{y}.png; no remote tiles are fetched by default.
# VITE_LEAFLET_TILE_URL=
# Optional absolute local paths; defaults use cached PP-OCRv6 medium models under ~/.paddlex/official_models/.
# PADDLEOCR_DET_MODEL_DIR=
# PADDLEOCR_REC_MODEL_DIR=
LOCAL_OCR_MAX_DIMENSION=2500
LOCAL_OCR_MAX_PAGES=8
LOCAL_OCR_MAX_PIXELS=40000000
PAO_CHECKBOX_MODE=strict
PAO_SPACY_DEBUG=false
