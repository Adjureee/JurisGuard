DATABASE_URL=postgresql://postgres:change-me@localhost:5432/jurisguard
SECRET_KEY=
# Generate a private value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Required only for initial admin registration; set a random 32+ character server-only key, then remove it.
# ADMIN_BOOTSTRAP_KEY=
MISTRAL_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api
# Put these VITE_ values in frontend/.env.local. This optional online basemap
# provides roads and boundaries; the local reference layer remains the fallback.
# VITE_LEAFLET_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_LEAFLET_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Optional locally hosted map tile URL, e.g. /tiles/{z}/{x}/{y}.png; no remote tiles are fetched by default.
# VITE_LEAFLET_TILE_URL=
# Optional absolute local paths; model names follow the selected profile under ~/.paddlex/official_models/.
# PADDLEOCR_DET_MODEL_DIR=
# PADDLEOCR_REC_MODEL_DIR=
PADDLEOCR_MODEL_PROFILE=mobile
# mobile: PP-OCRv5 mobile models for interactive CPU use.
# medium: PP-OCRv6 medium models at the normal image limits.
# handwriting: same cached medium models with larger image/detection limits; slower on CPU.
PADDLEOCR_RECOGNITION_BATCH_SIZE=8
# Leave these unset to use profile defaults. Set both explicitly only after measuring.
# mobile/medium: 2500 working pixels, 1280 detection pixels.
# handwriting: 3200 working pixels, 1920 detection pixels.
# LOCAL_OCR_MAX_DIMENSION=2500
# LOCAL_OCR_DET_MAX_DIMENSION=1280
# Load spaCy/OpenCV only when their document path needs them. Existing
# PADDLEOCR_MAX_DIMENSION and PADDLEOCR_DET_LIMIT_SIDE_LEN names remain accepted.
PADDLEOCR_CPU_THREADS=4
PADDLEOCR_ENABLE_MKLDNN=false
# API hard deadline includes worker/model startup. The worker is stopped on timeout.
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=180
# Set VITE_ values in frontend/.env.local. Keep this limit above the backend limit.
VITE_DOCUMENT_EXTRACTION_TIMEOUT_MS=200000
LOCAL_OCR_MAX_PAGES=8
LOCAL_OCR_MAX_PIXELS=40000000
PAO_CHECKBOX_MODE=strict
PAO_SPACY_DEBUG=false
