DATABASE_URL=postgresql://postgres:change-me@localhost:5432/jurisguard
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Protected legal-document store. This directory must not be served by a web/static route.
DOCUMENT_STORE_DIR=protected_documents
# Required: URL-safe base64 encoding of exactly 32 random bytes. Do not commit the value.
DOCUMENT_ENCRYPTION_KEY=
# Institutional policy gate for Mistral. Cloud extraction also needs authorized-user confirmation per request.
CLOUD_FALLBACK_ENABLED=false
# A value of 0 disables confidence-triggered fallback. If set, this is compared to the mean
# PaddleOCR recognition confidence. Completeness is populated configured fields / configured fields.
OFFLINE_MIN_AVERAGE_OCR_CONFIDENCE=0
OFFLINE_REQUIRED_FIELDS=
MISTRAL_API_KEY=
VITE_API_BASE_URL=http://localhost:8000
PADDLEOCR_MAX_DIMENSION=1600
PADDLEOCR_DET_LIMIT_SIDE_LEN=960
PADDLEOCR_DET_MODEL_NAME=PP-OCRv4_mobile_det
PADDLEOCR_REC_MODEL_NAME=en_PP-OCRv4_mobile_rec
PADDLEOCR_ENABLE_ANGLE_CLS=false
PADDLEOCR_ENHANCED_PREPROCESS=false
PADDLEOCR_CPU_THREADS=4
PADDLEOCR_ENABLE_MKLDNN=false
PADDLEOCR_USE_GPU=false
PAO_CHECKBOX_MODE=strict
PAO_SPACY_DEBUG=false
